    },
    "TLS-verschlüsselt im lokalen Netzwerk. Kein Konto und keine Cloud. Kopplungsschlüssel werden im Schlüsselbund gespeichert; Bildschirminhalte werden nicht aufgezeichnet. Die Bildschirmvorschau muss separat am Mac freigegeben werden. Beim Wechsel in den Hintergrund wird die Verbindung beendet." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLS-verschlüsselt im lokalen Netzwerk. Kein Konto und keine Cloud. Kopplungsschlüssel werden im Schlüsselbund gespeichert; Bildschirminhalte werden nicht aufgezeichnet. Die Bildschirmvorschau muss separat am Mac freigegeben werden. Beim Wechsel in den Hintergrund wird die Verbindung beendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLS-encrypted on the local network. No account or cloud. Pairing keys are saved in Keychain; screen content is not recorded. Screen preview requires separate approval on the Mac. Moving the app to the background ends the connection."
          }
        }
      }
    },

          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings have changed on the Mac or iPad. Reload before saving."
          }
        }
      }
    },
    "Die Freigabe überträgt den ausgewählten Bildschirm ohne eigene PresentInk-Fenster. macOS fragt nach Bildschirmaufnahmezugriff. Ohne Freigabe bleibt das iPad als leeres Zeichentablett nutzbar." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Freigabe überträgt den ausgewählten Bildschirm ohne eigene PresentInk-Fenster. macOS fragt nach Bildschirmaufnahmezugriff. Ohne Freigabe bleibt das iPad als leeres Zeichentablett nutzbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharing sends the selected display without PresentInk overlays. macOS requests screen recording access. Without sharing, the iPad still works as a blank drawing tablet."
          }
        }
      }
    },
    "Die laufende PresentInk-App ist nicht erreichbar." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {

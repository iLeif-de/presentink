<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon.icns</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>PresentInk</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.9.2</string>
	<key>CFBundleVersion</key>
	<string>18</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<false/>
	<key>NSAppleScriptEnabled</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_presentink._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>PresentInk verbindet dein iPad im lokalen Netzwerk, um Pencil-Annotationen auf dem Mac anzuzeigen und optional die Bildschirmvorschau zu übertragen.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>PresentInk steuert Keynote und PowerPoint, wenn du am verbundenen iPad die Folienpfeile betätigst.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Die ausgewählte Bildschirmquelle wird auf deinem verbundenen iPad als Zeichenhintergrund angezeigt. Es wird nichts aufgezeichnet.</string>
	<key>OSAScriptingDefinition</key>
	<string>PresentInk.sdef</string>
	<key>PresentInkShortcutsKeychainGroup</key>
	<string>$(AppIdentifierPrefix)de.presentink.mac.shortcuts</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
		<string>en</string>
	</array>
</dict>
</plist>
